@echo off
echo Cleaning global npm cache...
rmdir /s /q "%LOCALAPPDATA%\npm-cache" 2>nul
echo Done.

echo Navigating to backend...
cd /d "c:\xampp\htdocs\call wendor\my-react-app\urgify\urgify-backend"
echo Nuking backend node_modules...
rmdir /s /q node_modules 2>nul
del /f /q package-lock.json 2>nul
echo Reinstalling backend...
call npm install

echo Navigating to frontend...
cd /d "c:\xampp\htdocs\call wendor\my-react-app\urgify\urgify-app"
echo Nuking frontend node_modules...
rmdir /s /q node_modules 2>nul
del /f /q package-lock.json 2>nul
echo Reinstalling frontend...
call npm install --legacy-peer-deps

echo All repairs finished!
